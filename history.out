  148  sync
  149  systemctl reboot
  150  mephi_check_after_reboot() {     local actual expected;     hostnamectl --static;     [[ "$(hostnamectl --static)" == mephi-2026.domain.local ]] || return 1;     [[ "$(systemctl get-default)" == multi-user.target ]] || return 1;     [[ "$(getenforce)" == Enforcing ]] || return 1;     mountpoint -q /mephi-web || return 1;     findmnt /mephi-web;     [[ "$(findmnt -n -o FSTYPE /mephi-web)" == ext4 ]] || return 1;     [[ "$(findmnt -n -o LABEL /mephi-web)" == MEPHI_WEB ]] || return 1;     systemctl is-enabled --quiet nginx || return 1;     systemctl is-active --quiet nginx || return 1;     nginx -t || return 1;     getcap /usr/sbin/tcpdump;     getcap /usr/sbin/tcpdump | grep -q 'cap_net_raw' || return 1;     getcap /usr/sbin/tcpdump | grep -q 'cap_net_admin' || return 1;     ls -Zd /mephi-web /mephi-web/index.html;     getfacl /data/mephi-2026;     runuser -u user2 -- test -w /data/mephi-2026/test-user1/file.txt || return 1;     runuser -u curator1 -- test -r /data/mephi-2026/test-user1/file.txt || return 1;     if runuser -u curator1 -- test -w /data/mephi-2026/test-user1/file.txt; then return 1; fi;     grep -q 'accessfile=/etc/security/mephi-console-access.conf' /etc/pam.d/login || return 1;     authselect check || return 1;     expected="Hello from Student: 372185";     actual=$(curl --fail --silent --show-error --noproxy '*' http://localhost/) || return 1;     printf '%s\n' "$actual";     [[ "$actual" == "$expected" ]] || return 1;     ping -c 4 8.8.8.8 || return 1;     echo 'PASS: проверки после перезагрузки'; }
  151  mephi_check_after_reboot > "/root/mephi-session-project-2026/reboot-check.out" 2>&1
  152  cat "/root/mephi-session-project-2026/reboot-check.out"
  153  mephi_collect_results() {     ping -c 4 8.8.8.8 > /root/ping.out 2>&1 || return 1;     stat /data/mephi-2026 > /root/stat.out || return 1;     stat /mephi-web >> /root/stat.out || return 1;     getcap /usr/sbin/tcpdump > /root/getcap.out || return 1;     dnf history > /root/dnf.out || return 1;     journalctl -u nginx -b --no-pager > /root/journalctl.out || return 1;     getenforce > /root/getenforce.out || return 1;     curl --fail --silent --show-error --noproxy '*' http://localhost/ > /root/curl.out || return 1;     history -a;     history > /root/history.out;     command cp /root/ping.out /root/stat.out /root/getcap.out /root/dnf.out        /root/journalctl.out /root/getenforce.out /root/curl.out /root/history.out "/root/mephi-session-project-2026/" || return 1;     command cp /etc/fstab /etc/passwd /etc/group /etc/security/pwquality.conf "/root/mephi-session-project-2026/" || return 1;     getfacl -R /data/mephi-2026 > "/root/mephi-session-project-2026/acl.out";     semanage fcontext -l -C > "/root/mephi-session-project-2026/selinux-local.out";     command cp /etc/nginx/nginx.conf "/root/mephi-session-project-2026/nginx.conf";     command cp /etc/systemd/system/nginx.service.d/mephi-mount.conf "/root/mephi-session-project-2026/nginx-mount.conf";     command cp /etc/pam.d/login "/root/mephi-session-project-2026/pam-login";     command cp /etc/security/mephi-console-access.conf "/root/mephi-session-project-2026/mephi-console-access.conf";     command cp /etc/login.defs "/root/mephi-session-project-2026/login.defs";     command cp /etc/pam.d/system-auth "/root/mephi-session-project-2026/pam-system-auth";     command cp /etc/pam.d/password-auth "/root/mephi-session-project-2026/pam-password-auth";     {         for u in root vitaliy user1 user2 user3 curator1 curator2; do             printf '\n=== %s ===\n' "$u";             chage -l "$u";         done;     } > "/root/mephi-session-project-2026/password-aging.out";     {         hostnamectl;         cat /etc/os-release;         nmcli device status;         ip -4 address;         ip route;         findmnt /mephi-web;         lsblk -f;         systemctl is-enabled nginx;         systemctl is-active nginx;         systemctl cat nginx;         rpm -q nginx tcpdump libcap-ng-utils;     } > "/root/mephi-session-project-2026/system-checks.out" 2>&1;     echo 'Основные результаты собраны'; }
  154  mephi_collect_results
