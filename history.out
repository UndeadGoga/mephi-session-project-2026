  105  mephi_create_page() {     mountpoint -q /mephi-web || { echo 'Диск не смонтирован. СТОП'; return 1; };     chown root:root /mephi-web;     chmod 0755 /mephi-web;     printf 'Hello from Student: %s\n' "372185" > /mephi-web/index.html;     chmod 0644 /mephi-web/index.html;     if semanage fcontext -l -C | awk '{print $1}' | grep -Fxq '/mephi-web(/.*)?'; then         semanage fcontext -m -t httpd_sys_content_t '/mephi-web(/.*)?' || return 1;     else         semanage fcontext -a -t httpd_sys_content_t '/mephi-web(/.*)?' || return 1;     fi;     restorecon -Rv /mephi-web || return 1;     ls -Zd /mephi-web /mephi-web/index.html; }
  106  mephi_create_page
