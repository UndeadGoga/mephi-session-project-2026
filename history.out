   71  mephi_test_tcpdump
   72  cat > /etc/security/pwquality.conf <<'EOF'
   73  # MEPHI: real minimum password length, including root-initiated changes
   74  minlen = 12
   75  dcredit = 0
   76  ucredit = 0
   77  lcredit = 0
   78  ocredit = 0
   79  enforcing = 1
   80  enforce_for_root
   81  EOF
   82  chmod 0644 /etc/security/pwquality.conf
   83  mephi_password_pam() {     local file;     authselect current || true;     if [[ ! -d /etc/authselect/custom/mephi ]]; then         authselect create-profile mephi --base-on=sssd || return 1;     fi;     for file in /etc/authselect/custom/mephi/system-auth /etc/authselect/custom/mephi/password-auth; do         grep -Eq '^[[:space:]]*password[[:space:]].*pam_pwquality[.]so' "$file" || {             echo "В $file нет ожидаемого pam_pwquality. СТОП"; return 1;         };         sed -i -E '/^[[:space:]]*password[[:space:]].*pam_pwquality[.]so/c\password requisite pam_pwquality.so retry=3 minlen=12 dcredit=0 ucredit=0 lcredit=0 ocredit=0 enforcing=1 enforce_for_root' "$file" || return 1;     done;     authselect select custom/mephi with-faillock --force -b || return 1;     authselect check || return 1;     grep -H 'pam_pwquality' /etc/pam.d/system-auth /etc/pam.d/password-auth; }
   84  mephi_password_pam
   85  mephi_password_age() {     local key value min_uid user;     for key in PASS_MAX_DAYS PASS_MIN_DAYS PASS_WARN_AGE; do         case "$key" in             PASS_MAX_DAYS) value=90 ;;             PASS_MIN_DAYS) value=0 ;;             PASS_WARN_AGE) value=7 ;;         esac;         if grep -qE "^[[:space:]]*$key[[:space:]]+" /etc/login.defs; then             sed -i -E "s/^[[:space:]]*$key[[:space:]]+.*/$key $value/" /etc/login.defs || return 1;         else             printf '%s %s\n' "$key" "$value" >> /etc/login.defs;         fi;     done;     min_uid=$(awk '$1=="UID_MIN" {print $2; exit}' /etc/login.defs);     min_uid=${min_uid:-1000};     while IFS= read -r user; do         chage -M 90 -m 0 -W 7 "$user" || return 1;     done < <(awk -F: -v min="$min_uid" '$3==0 || ($3>=min && $3<65534 && $7 !~ /(nologin|false)$/) {print $1}' /etc/passwd);     chage -l user1;     chage -l "АДМИН"; }
