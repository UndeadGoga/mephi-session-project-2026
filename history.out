   63  (     set -e;      dnf -y install dnf-plugins-core libcap libcap-ng-utils;      rpm_dir=$(mktemp -d /tmp/mephi-tcpdump.XXXXXX);      dnf download --resolve --alldeps         --downloaddir="$rpm_dir"         "tcpdump.$(rpm --eval '%{_arch}')";      deps=();     tcpdump_rpms=();      for pkg in "$rpm_dir"/*.rpm; do         if [ "$(rpm -qp --qf '%{NAME}' "$pkg")" = tcpdump ]; then             tcpdump_rpms+=("$pkg");         else             deps+=("$pkg");         fi;     done;      [ "${#tcpdump_rpms[@]}" -eq 1 ];      if [ "${#deps[@]}" -gt 0 ]; then         dnf -y install "${deps[@]}";     fi;      rpm -K "${tcpdump_rpms[0]}";     rpm -Uvh --replacepkgs "${tcpdump_rpms[0]}";      tcpdump_bin=$(rpm -ql tcpdump | awk '/\/s?bin\/tcpdump$/ {print; exit}');     test -n "$tcpdump_bin";     test -x "$tcpdump_bin";      chmod 0755 "$tcpdump_bin";     setcap 'cap_net_raw,cap_net_admin=ep' "$tcpdump_bin";      getcap "$tcpdump_bin";      echo 'ГОТОВО: tcpdump установлен, capabilities назначены'; )
   64  (     set -e;      dnf -y install libpcap libcap-ng libcap;      rpm_dir=$(mktemp -d /tmp/mephi-tcpdump-fixed.XXXXXX);      dnf download --downloaddir="$rpm_dir"         "tcpdump.$(rpm --eval '%{_arch}')";      rpms=("$rpm_dir"/tcpdump-*.rpm);     [ "${#rpms[@]}" -eq 1 ];     test -f "${rpms[0]}";      rpm -K "${rpms[0]}";     rpm -Uvh --replacepkgs --test "${rpms[0]}";     rpm -Uvh --replacepkgs "${rpms[0]}";      tcpdump_bin=$(rpm -ql tcpdump | awk '/\/s?bin\/tcpdump$/ {print; exit}');     test -n "$tcpdump_bin";     test -x "$tcpdump_bin";      chmod 0755 "$tcpdump_bin";     setcap 'cap_net_raw,cap_net_admin=ep' "$tcpdump_bin";     getcap "$tcpdump_bin";      mkdir -p /root/mephi-session-project-2026;     rpm -qi tcpdump > /root/mephi-session-project-2026/tcpdump-rpm.out;      echo 'ГОТОВО: tcpdump установлен и настроен'; )
