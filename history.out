  141  mephi_start_nginx() {     nginx -t || return 1;     systemctl enable nginx || return 1;     systemctl restart nginx || return 1;     systemctl is-enabled nginx;     systemctl is-active nginx;     systemctl --no-pager --full status nginx;     curl --fail --silent --show-error --noproxy '*' http://127.0.0.1/; }
