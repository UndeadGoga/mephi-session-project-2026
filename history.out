   42  mephi_prepare_disk() {     local disk confirm part signatures;     lsblk -e 7 -o NAME,PATH,SIZE,TYPE,FSTYPE,LABEL,MOUNTPOINTS;     read -r -p 'Полный путь к ПУСТОМУ второму диску: ' disk;     [[ "$disk" == /dev/* && -b "$disk" ]] || { echo 'Это не блочное устройство'; return 1; };     [[ "$(lsblk -dn -o TYPE "$disk")" == disk ]] || { echo 'Нужен целый диск'; return 1; };     [[ "$(lsblk -nr -o NAME "$disk" | wc -l)" -eq 1 ]] || { echo 'На диске есть разделы/дочерние устройства. СТОП'; return 1; };     if lsblk -nr -o MOUNTPOINTS "$disk" | grep -q '[^[:space:]]'; then         echo 'Диск используется. СТОП'; return 1;     fi;     signatures=$(wipefs --no-act --noheadings --output TYPE "$disk") || return 1;     [[ -z "$signatures" ]] || { echo 'Найдены сигнатуры. Нужен новый пустой диск'; return 1; };     if blkid -L MEPHI_WEB >/dev/null 2>&1; then         echo 'Метка MEPHI_WEB уже существует. Повторно форматировать не надо'; return 1;     fi;     lsblk -d -o PATH,SIZE,MODEL,SERIAL "$disk";     read -r -p "Для форматирования введите точно ERASE $disk : " confirm;     [[ "$confirm" == "ERASE $disk" ]] || { echo 'Отменено'; return 1; };     parted -s "$disk" mklabel gpt || return 1;     parted -s -a optimal "$disk" mkpart primary ext4 1MiB 100% || return 1;     partprobe "$disk" || return 1;     udevadm settle || return 1;     part=$(lsblk -nrpo NAME,TYPE "$disk" | awk '$2=="part" {print $1}');     [[ -n "$part" && "$part" != *$'\n'* && -b "$part" ]] || { echo 'Не найден единственный раздел'; return 1; };     mkfs.ext4 -L MEPHI_WEB "$part" || return 1;     blkid "$part"; }
