   52  (     set -e;      test -b /dev/sdb;      if [ "$(lsblk -nr -o NAME /dev/sdb | wc -l)" -ne 1 ]; then         echo 'СТОП: на диске уже есть разделы';         exit 1;     fi;      signatures=$(wipefs --no-act --noheadings --output TYPE /dev/sdb);     if [ -n "$signatures" ]; then         echo 'СТОП: на диске обнаружены данные';         exit 1;     fi;      parted -s /dev/sdb mklabel gpt;     parted -s -a optimal /dev/sdb mkpart primary ext4 1MiB 100%;     partprobe /dev/sdb;     udevadm settle;      mkfs.ext4 -L MEPHI_WEB /dev/sdb1;      mkdir -p /mephi-web;      if ! awk '$1 !~ /^#/ && ($1=="LABEL=MEPHI_WEB" || $2=="/mephi-web") {found=1} END {exit !found}' /etc/fstab; then         printf '\nLABEL=MEPHI_WEB /mephi-web ext4 defaults,nodev,nosuid,noexec 0 2\n' >> /etc/fstab;     fi;      systemctl daemon-reload;     mount /mephi-web;     findmnt /mephi-web;      echo 'ГОТОВО: диск подготовлен и смонтирован'; )
   53  mephi_create_users() {     local name uid;     for name in user1 user2 user3 curator1 curator2; do         if getent passwd "$name" >/dev/null; then             echo "Пользователь $name уже существует. Не создавайте повторно"; return 1;         fi;     done;     for uid in 5501 5502 5503; do         if getent passwd "$uid" >/dev/null; then             echo "UID $uid уже занят"; return 1;         fi;     done;     if getent group curators >/dev/null || getent group 4444 >/dev/null || getent group mephi-dev >/dev/null; then         echo 'Группа/нужный GID уже существует. Проверьте конфликты'; return 1;     fi;     groupadd mephi-dev || return 1;     groupadd -g 4444 curators || return 1;     useradd -m -u 5501 -g mephi-dev -s /bin/bash user1 || return 1;     useradd -m -u 5502 -g mephi-dev -s /bin/bash user2 || return 1;     useradd -m -u 5503 -g mephi-dev -s /bin/bash user3 || return 1;     useradd -m -g curators -s /bin/bash curator1 || return 1;     useradd -m -g curators -s /bin/bash curator2 || return 1;     mkdir -p /data/mephi-2026;     chmod 0755 /data;     chown root:mephi-dev /data/mephi-2026;     chmod 2770 /data/mephi-2026;     setfacl -m u::rwx,g::rwx,g:curators:r-x,m::rwx,o::--- /data/mephi-2026 || return 1;     setfacl -d -m u::rwx,g::rwx,g:curators:r-x,m::rwx,o::--- /data/mephi-2026 || return 1;     restorecon -Rv /data;     id user1;     id user2;     id user3;     id curator1;     id curator2;     getfacl /data/mephi-2026; }
   54  mephi_create_users
   55  mephi_test_acl() {     local writer reader file;     for writer in user1 user2 user3; do         runuser -u "$writer" -- sh -c 'umask 077; mkdir -p "/data/mephi-2026/test-$1"; printf "created by %s\n" "$1" > "/data/mephi-2026/test-$1/file.txt"' sh "$writer" || return 1;         file="/data/mephi-2026/test-$writer/file.txt";         for reader in user1 user2 user3; do             runuser -u "$reader" -- sh -c 'printf "edited by %s\n" "$1" >> "$2"; cat "$2"' sh "$reader" "$file" || return 1;         done;         for reader in curator1 curator2; do             runuser -u "$reader" -- cat "$file" || return 1;             if runuser -u "$reader" -- sh -c 'printf "forbidden\n" >> "$1"' sh "$file"; then                 echo 'ОШИБКА: куратор смог писать'; return 1;             fi;             if runuser -u "$reader" -- touch "/data/mephi-2026/forbidden-$reader"; then                 echo 'ОШИБКА: куратор смог создать файл'; return 1;             fi;         done;     done;     if runuser -u nobody -- cat /data/mephi-2026/test-user1/file.txt; then         echo 'ОШИБКА: посторонний смог прочитать файл'; return 1;     fi;     echo 'PASS: совместная запись, чтение кураторов и запрет для посторонних'; }
   56  mephi_test_acl > "/root/mephi-session-project-2026/access-tests.out" 2>&1
   57  cat "/root/mephi-session-project-2026/access-tests.out"
